# FastAPI Application Configuration
APP_NAME="Gokul J Portfolio API"
APP_ENV=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite:///./portfolio.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db
# For MySQL in production:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/portfolio_db

# CORS Configuration (comma-separated or wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Gmail SMTP Notification Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jgokul823@gmail.com
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_USE_TLS=True
NOTIFICATION_EMAIL=jgokul823@gmail.com

# Cloudinary Integration (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
